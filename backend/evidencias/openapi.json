{
  "openapi": "3.1.0",
  "info": {
    "title": "Bee Good Food API",
    "description": "Consulta pública de categorias. Autenticação e gestão de pedidos serão adicionadas nas próximas etapas.",
    "version": "v1"
  },
  "tags": [
    {
      "name": "Categorias",
      "description": "Consulta de categorias ativas do catálogo"
    }
  ],
  "paths": {
    "/api/v1/categorias": {
      "get": {
        "tags": [
          "Categorias"
        ],
        "summary": "Listar categorias ativas",
        "description": "Página começa em zero; tamanho entre 1 e 100. Ordenação por nome e ID.",
        "operationId": "listar",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "maximum": 1000000,
              "minimum": 0
            }
          },
          {
            "name": "tamanho",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaResponseCategoriaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categorias/{id}": {
      "get": {
        "tags": [
          "Categorias"
        ],
        "summary": "Consultar categoria ativa pelo ID",
        "operationId": "buscar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CategoriaResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CategoriaResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "nome": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "PaginaResponseCategoriaResponse": {
        "type": "object",
        "properties": {
          "conteudo": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoriaResponse"
            }
          },
          "pagina": {
            "type": "integer",
            "format": "int32"
          },
          "tamanho": {
            "type": "integer",
            "format": "int32"
          },
          "totalElementos": {
            "type": "integer",
            "format": "int64"
          },
          "totalPaginas": {
            "type": "integer",
            "format": "int32"
          },
          "ultima": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
