{
  "openapi": "3.1.0",
  "info": {
    "title": "Bee Good Food API",
    "description": "Categorias públicas, cadastro de cliente adulto e autenticação JWT. Pedidos ainda não implementados.",
    "version": "v1"
  },
  "tags": [
    {
      "name": "Categorias",
      "description": "Consulta de categorias ativas do catálogo"
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Entrar",
        "description": "JWT válido por 15 minutos; não existe refresh token. Guardar apenas em memória no frontend.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/cadastro": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Cadastrar cliente adulto",
        "description": "Autodeclaração obrigatória. Somente papel CLIENTE; senha de 12 a 72 caracteres, limitada a 72 bytes UTF-8.",
        "operationId": "cadastrar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CadastroRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categorias": {
      "get": {
        "tags": [
          "Categorias"
        ],
        "summary": "Listar categorias ativas",
        "description": "Página começa em zero; tamanho entre 1 e 100. Ordenação por nome e ID.",
        "operationId": "listar",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "maximum": 1000000,
              "minimum": 0
            }
          },
          {
            "name": "tamanho",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaResponseCategoriaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categorias/{id}": {
      "get": {
        "tags": [
          "Categorias"
        ],
        "summary": "Consultar categoria ativa pelo ID",
        "operationId": "buscar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CategoriaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Consultar a própria conta ativa",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/admin/usuarios": {
      "get": {
        "tags": [
          "admin-usuario-controller"
        ],
        "summary": "Listar usuários (administrador)",
        "description": "Somente campos do cadastro e papéis; nunca senha, hash ou token.",
        "operationId": "listar_1",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "maximum": 1000000,
              "minimum": 0
            }
          },
          {
            "name": "tamanho",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaResponseUsuarioResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320,
            "minLength": 0
          },
          "senha": {
            "type": "string",
            "maxLength": 72,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "senha"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tipoToken": {
            "type": "string"
          },
          "expiraEmSegundos": {
            "type": "integer",
            "format": "int64"
          },
          "usuario": {
            "$ref": "#/components/schemas/UsuarioResponse"
          }
        }
      },
      "UsuarioResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "ativo": {
            "type": "boolean"
          },
          "papeis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CadastroRequest": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 150,
            "minLength": 0
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320,
            "minLength": 0
          },
          "senha": {
            "type": "string",
            "maxLength": 72,
            "minLength": 12
          },
          "maiorDeIdade": {
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "maiorDeIdade",
          "nome",
          "senha"
        ]
      },
      "CategoriaResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "nome": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "PaginaResponseCategoriaResponse": {
        "type": "object",
        "properties": {
          "conteudo": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoriaResponse"
            }
          },
          "pagina": {
            "type": "integer",
            "format": "int32"
          },
          "tamanho": {
            "type": "integer",
            "format": "int32"
          },
          "totalElementos": {
            "type": "integer",
            "format": "int64"
          },
          "totalPaginas": {
            "type": "integer",
            "format": "int32"
          },
          "ultima": {
            "type": "boolean"
          }
        }
      },
      "PaginaResponseUsuarioResponse": {
        "type": "object",
        "properties": {
          "conteudo": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsuarioResponse"
            }
          },
          "pagina": {
            "type": "integer",
            "format": "int32"
          },
          "tamanho": {
            "type": "integer",
            "format": "int32"
          },
          "totalElementos": {
            "type": "integer",
            "format": "int64"
          },
          "totalPaginas": {
            "type": "integer",
            "format": "int32"
          },
          "ultima": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
