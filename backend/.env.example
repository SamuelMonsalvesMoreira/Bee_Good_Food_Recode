# Modelo de variaveis. O Spring Boot nao carrega este arquivo automaticamente.
# Configure estas variaveis no terminal ou na configuracao de execucao da IDE.
# Crie um schema NOVO para o Flyway; nao reutilize o banco montado manualmente.
DB_URL=jdbc:mysql://127.0.0.1:3306/bee_good_food?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USER=bee_app
DB_PASSWORD=SUBSTITUA_PELA_SENHA_LOCAL
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
# Gere 32 bytes aleatorios em Base64 (veja README). Nao use este texto como segredo.
JWT_SECRET_BASE64=SUBSTITUA_POR_SEGREDO_ALEATORIO_BASE64
